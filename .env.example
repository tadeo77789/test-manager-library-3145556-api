APP_NAME="Manager Library API"
APP_ENV=production
# Generated at container start when empty (not used for auth; JWT_SECRET is).
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=change-me
DB_SCHEMA=library

# Authentication (replace with real secrets in the real .env; never commit it)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

COVERS_DIR=/var/www/storage/app/covers
CORS_ORIGIN=http://localhost:5173

# Overdue demo support: shifts the SystemClock by N days (default 0 = real time).
CLOCK_OFFSET_DAYS=0

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
